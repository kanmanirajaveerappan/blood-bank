# LifeLink AI - Environment Configuration Template

# Google Maps API (Frontend - only VITE_ variables are exposed to browser)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Neon PostgreSQL Connection String (Backend only - never exposed to browser)
# Example: postgresql://<user>:<password>@<ep-xyz-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Settings
DEBUG=True
JWT_SECRET=lifelink-emergency-secret-key-2026
PORT=8000

